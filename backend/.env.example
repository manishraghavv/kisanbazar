# ─────────────────────────────────────────────────────────────
#  BACKEND ENVIRONMENT VARIABLES — Multi-Vendor Agri-Commerce
#  Copy to .env and fill in your values:
#    cp .env.example .env
# ─────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# Comma-separated allow-list. REQUIRED in production, and "*" is rejected there.
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# ── Database (PostgreSQL) ───────────────────────────────────
DATABASE_URL=postgresql://multivenor:multivenor_secret@localhost:5432/multivenor_db?schema=public

# ── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── JWT Authentication ──────────────────────────────────────
# REQUIRED. The server refuses to start if a secret is missing, shorter than
# 32 chars, a known-weak/placeholder value, or if both secrets are identical.
# Generate each with:  openssl rand -hex 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Access token TTL: max 15m (enforced at boot)
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── SMS (Twilio) — for OTP verification ─────────────────────
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890
MSG91_AUTH_KEY=

# ── Email (Resend) ──────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# ── Amazon S3 / File Upload ─────────────────────────────────
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_BUCKET=multivenor-uploads

# ── Payment Gateway ─────────────────────────────────────────
DEFAULT_PAYMENT_GATEWAY=razorpay
RAZORPAY_KEY_ID=your-razorpay-key
RAZORPAY_KEY_SECRET=your-razorpay-secret
# REQUIRED in production (>=16 chars). Webhooks are rejected with 503 when unset.
RAZORPAY_WEBHOOK_SECRET=
PAYU_MERCHANT_KEY=
PAYU_MERCHANT_SALT=

# ── Operational endpoints (production) ──────────────────────
# /metrics needs "Authorization: Bearer <METRICS_TOKEN>" or an ADMIN access token.
# Generate with: openssl rand -hex 32
METRICS_TOKEN=
# Swagger UI (/api/docs) and Bull Board are disabled in production unless enabled here.
ENABLE_API_DOCS=false
ENABLE_BULL_BOARD=false

# ── Sentry (Error Monitoring) ───────────────────────────────
SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# ── Socket.io ───────────────────────────────────────────────
SOCKET_CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# Reverse-proxy hops in front of the app (nginx = 1; production defaults to 1, dev to 0)
TRUST_PROXY=0

# ── Rate Limiting ───────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_AUTH=10
RATE_LIMIT_MAX_GENERAL=300
RATE_LIMIT_MAX_STRICT=5

# ── Khata Settings ──────────────────────────────────────────
INTEREST_GRACE_PERIOD_DAYS=7
OVERDUE_ESCALATION_DAYS=30
OVERDUE_AUTO_SUSPEND_DAYS=60

# ── Background Jobs ─────────────────────────────────────────
CRON_INTEREST_ENABLED=true
CRON_STATEMENT_ENABLED=true
CRON_SETTLEMENT_ENABLED=true

# ── Logging ─────────────────────────────────────────────────
LOG_LEVEL=debug
