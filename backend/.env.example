# ─────────────────────────────────────────────────────────────
#  BACKEND ENVIRONMENT VARIABLES — Multi-Vendor Agri-Commerce
#  Copy to .env and fill in your values:
#    cp .env.example .env
#  Every variable the code reads is listed here (defaults in comments).
# ─────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# Public base URL used to build links to uploaded files (default http://localhost:$PORT)
API_BASE_URL=http://localhost:3000
# Comma-separated allow-list. REQUIRED in production, and "*" is rejected there.
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
# Reverse-proxy hops in front of the app (nginx = 1; production defaults to 1, dev to 0)
TRUST_PROXY=0

# ── Database (PostgreSQL) ───────────────────────────────────
# docker compose exposes Postgres on host port 5433 (user/password/db: multivendor / multivendor_dev / multivendor)
DATABASE_URL=postgresql://multivendor:multivendor_dev@localhost:5433/multivendor?schema=public
# Integration tests only (npm test). Defaults to the docker `postgres-test` service on port 5434.
# TEST_DATABASE_URL=postgresql://test:test@localhost:5434/multivendor_test?schema=public

# ── Redis (optional: cache, BullMQ queues; app degrades gracefully without it) ──
# docker compose exposes Redis on host port 6380
REDIS_URL=redis://localhost:6380
# Fallback used by the queue code when REDIS_URL is unset
REDIS_URL_QUEUES=
# Prefix for BullMQ queue names (default "kb")
QUEUE_PREFIX=kb

# ── JWT Authentication ──────────────────────────────────────
# REQUIRED. The server refuses to start if a secret is missing, shorter than
# 32 chars, a known-weak/placeholder value, or if both secrets are identical.
# Generate each with:  openssl rand -hex 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Access token TTL: max 15m (enforced at boot)
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Notifications ───────────────────────────────────────────
# Channels are off unless set to "true"; without them, messages/OTPs are only logged (never OTPs in production).
SMS_ENABLED=false
EMAIL_ENABLED=false
PUSH_ENABLED=false
# SMS (Twilio) — OTP verification
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=noreply@kisaanbazaar.com
EMAIL_FROM_NAME=Kisaan Bazaar

# ── Payments ────────────────────────────────────────────────
# REQUIRED in production (>=16 chars). Webhooks are rejected with 503 when unset.
RAZORPAY_WEBHOOK_SECRET=

# ── Operational endpoints (production) ──────────────────────
# /metrics needs "Authorization: Bearer <METRICS_TOKEN>" or an ADMIN access token.
# Generate with: openssl rand -hex 32
METRICS_TOKEN=
# Swagger UI (/api/docs) and Bull Board are disabled in production unless enabled here.
ENABLE_API_DOCS=false
ENABLE_BULL_BOARD=false

# ── Sentry (Error Monitoring, optional) ─────────────────────
SENTRY_DSN=

# ── Rate Limiting ───────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_AUTH=10
RATE_LIMIT_MAX_GENERAL=300
RATE_LIMIT_MAX_STRICT=5

# ── Khata Settings ──────────────────────────────────────────
INTEREST_GRACE_PERIOD_DAYS=7
OVERDUE_ESCALATION_DAYS=30
# Days overdue before an account is auto-suspended (default 60)
OVERDUE_SUSPEND_DAYS=60
# Days before the due date to send a repayment reminder (default 7)
REPAYMENT_REMINDER_DAYS_BEFORE=7

# ── Background Jobs (cron) ──────────────────────────────────
# Set to "false" to disable all cron jobs (default: enabled)
CRON_ENABLED=true
CRON_INTEREST_SCHEDULE="0 0 * * *"
CRON_OVERDUE_SCHEDULE="0 1 * * *"
CRON_CART_CLEANUP_SCHEDULE="0 3 * * *"
CRON_PRICE_ALERT_SCHEDULE="0 4 * * *"
CRON_REPAYMENT_REMINDER_SCHEDULE="0 8 * * *"
# Carts untouched for this many days are cleared (default 7)
CART_EXPIRY_DAYS=7
# Minimum % price drop that triggers a wishlist price alert (default 5)
PRICE_ALERT_THRESHOLD_PCT=5

# ── Seed script (prisma/seed.ts, development only) ──────────
# Passwords for seeded users. Falls back to the documented DEV-ONLY default "Password@123". Never used in production.
# SEED_PASSWORD=
# SEED_ADMIN_PASSWORD=
# SEED_VENDOR_PASSWORD=
# SEED_FARMER_PASSWORD=

# ── Reserved for upcoming phases (NOT read by the code yet) ─
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# PAYU_MERCHANT_KEY=
# PAYU_MERCHANT_SALT=
# AWS_REGION=ap-south-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=
