# ─────────────────────────────────────────────────────────────
#  BACKEND ENVIRONMENT VARIABLES — Multi-Vendor Agri-Commerce
#  Copy to .env and fill in your values:
#    cp .env.example .env
# ─────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# ── Database (PostgreSQL) ───────────────────────────────────
DATABASE_URL=postgresql://multivenor:multivenor_secret@localhost:5432/multivenor_db?schema=public

# ── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── JWT Authentication ──────────────────────────────────────
JWT_ACCESS_SECRET=your-access-secret-change-this-in-production
JWT_REFRESH_SECRET=your-refresh-secret-change-this-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── SMS (Twilio) — for OTP verification ─────────────────────
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890
MSG91_AUTH_KEY=

# ── Email (Resend) ──────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# ── Amazon S3 / File Upload ─────────────────────────────────
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_BUCKET=multivenor-uploads

# ── Payment Gateway ─────────────────────────────────────────
DEFAULT_PAYMENT_GATEWAY=razorpay
RAZORPAY_KEY_ID=your-razorpay-key
RAZORPAY_KEY_SECRET=your-razorpay-secret
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret
PAYU_MERCHANT_KEY=
PAYU_MERCHANT_SALT=

# ── Sentry (Error Monitoring) ───────────────────────────────
SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# ── Socket.io ───────────────────────────────────────────────
SOCKET_CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# ── Rate Limiting ───────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_AUTH=10
RATE_LIMIT_MAX_GENERAL=100
RATE_LIMIT_MAX_STRICT=5

# ── Khata Settings ──────────────────────────────────────────
INTEREST_GRACE_PERIOD_DAYS=7
OVERDUE_ESCALATION_DAYS=30
OVERDUE_AUTO_SUSPEND_DAYS=60

# ── Background Jobs ─────────────────────────────────────────
CRON_INTEREST_ENABLED=true
CRON_STATEMENT_ENABLED=true
CRON_SETTLEMENT_ENABLED=true

# ── Logging ─────────────────────────────────────────────────
LOG_LEVEL=debug
