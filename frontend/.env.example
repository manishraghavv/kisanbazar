# ─────────────────────────────────────────────────────────────
#  FRONTEND ENVIRONMENT VARIABLES — Multi-Vendor Agri-Commerce
#  Copy to .env.local and fill in your values:
#    cp .env.example .env.local
# ─────────────────────────────────────────────────────────────

# ── API Configuration ────────────────────────────────────────
# Backend API URL (with /api suffix)
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Socket.io server URL (for real-time notifications)
NEXT_PUBLIC_SOCKET_URL=http://localhost:3000

# Application URL (for redirects, callbacks)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Feature Flags ────────────────────────────────────────────
# Enable real-time WebSocket connection
NEXT_PUBLIC_ENABLE_SOCKET=true

# Enable multi-language support (i18n)
NEXT_PUBLIC_ENABLE_I18N=true

# Default language (hi, en, mr, pa, ta)
NEXT_PUBLIC_DEFAULT_LANG=hi

# ── Analytics (optional) ─────────────────────────────────────
# Google Analytics Measurement ID
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Sentry DSN for error tracking (optional)
NEXT_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
