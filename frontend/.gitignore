# ─────────────────────────────────────────────────────────────
#  FRONTEND — Next.js 16 .gitignore
# ─────────────────────────────────────────────────────────────

# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Build outputs
/.next/
/out/
/build
/dist

# Testing
/coverage
.nyc_output/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Environment files
.env
.env.*
!.env.example
!.env.*.example

# Editor directories
.idea/
.vscode/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db
*.pem

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Vercel
.vercel

# Misc
.eslintcache
*.tgz

